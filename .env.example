# EasyMeeting 前端环境变量配置

# HTTP API 基础地址（开发阶段通过 Vite proxy 代理转发）
VITE_API_BASE_URL=/api

# WebSocket 信令服务器基准地址
# 若使用 Vite proxy 代理，可直接设置为相对协议如 ws://localhost:3000/ws 或直连后端 ws://localhost:7002/ws
VITE_WS_URL=ws://localhost:7002/ws

# 文件上传与预览基准地址
VITE_FILE_BASE_URL=/file

# 公网默认 STUN 服务器（用于 WebRTC P2P 打洞）
VITE_STUN_SERVER=stun:stun.l.google.com:19302

